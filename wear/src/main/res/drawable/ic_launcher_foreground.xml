<?xml version="1.0" encoding="utf-8"?>
<!-- Meridian (Wear) brand mark: wireframe globe + gold "solar noon" marker, centred within the
     adaptive-icon safe zone (radius 33 around 54,54). Matches the phone app foreground. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Globe rim -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:pathData="M54,27 a27,27 0 1,1 0,54 a27,27 0 1,1 0,-54 Z" />
    <!-- Equator -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:pathData="M27,54 L81,54" />
    <!-- Prime meridian -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:pathData="M54,27 L54,81" />
    <!-- Curved meridian (longitude) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.2"
        android:pathData="M54,27 a11,27 0 1,0 0,54 a11,27 0 1,0 0,-54" />
    <!-- Curved latitude -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.2"
        android:pathData="M27,54 a27,11 0 1,0 54,0 a27,11 0 1,0 -54,0" />
    <!-- Solar-noon marker -->
    <path
        android:fillColor="#FFC857"
        android:pathData="M54,22 a5,5 0 1,1 0,10 a5,5 0 1,1 0,-10 Z" />
</vector>
