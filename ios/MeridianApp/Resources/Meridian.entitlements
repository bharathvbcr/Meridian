<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Meridian — iOS app entitlements.

      App Group: shared with the widget extension and the watch app so the SwiftData
      store (ModelConfiguration(groupContainer:)), the pinned-zone snapshot
      (SharedZoneStore), and the cross-app interop snapshot all live in one container.
    -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.example.meridian</string>
    </array>

    <!--
      Optional, opt-in hardware-backed peer authenticity (PeerVerifier / DeviceCheck).
      The interop path works without it; remove this key if you do not provision
      App Attest for the team. Environment is build-config driven (Debug=development,
      Release=production) via MERIDIAN_APP_ATTEST_ENV in project.yml so dev/TestFlight
      builds attest against the development service.
    -->
    <key>com.apple.developer.devicecheck.appattest-environment</key>
    <string>$(MERIDIAN_APP_ATTEST_ENV)</string>
</dict>
</plist>
