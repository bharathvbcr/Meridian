<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Meridian</string>
    <key>CFBundleDisplayName</key>
    <string>Meridian</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <!-- ── URL scheme: meridian://world | meridian://plan ───────────────────── -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.example.meridian.deeplink</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>meridian</string>
            </array>
        </dict>
    </array>

    <!-- ── Live Activities (EventCountdown) ─────────────────────────────────── -->
    <key>NSSupportsLiveActivities</key>
    <true/>
    <key>NSSupportsLiveActivitiesFrequentUpdates</key>
    <false/>

    <!-- ── Background execution (BGAppRefreshTask re-arms the Live Activity) ──── -->
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
        <string>processing</string>
    </array>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <!-- Must match BackgroundRefreshScheduler.refreshTaskIdentifier. -->
        <string>com.example.meridian.liveactivity.refresh</string>
    </array>

    <!-- ── Privacy usage descriptions ───────────────────────────────────────── -->
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Meridian needs full calendar access to display and schedule your events.</string>
    <key>NSContactsUsageDescription</key>
    <string>Meridian uses your contacts to suggest meeting participants and time zones.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Meridian uses your location to show local time and suggest your home city.</string>

    <!-- ── Misc ─────────────────────────────────────────────────────────────── -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict>
</plist>
