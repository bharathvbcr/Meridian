<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Meridian watchOS app entitlements.

      Declares the shared App Group. The watch primarily receives state over
      WatchConnectivity (WatchSessionManager), but App Group membership keeps it on
      the same shared container as the phone and widget for any direct snapshot reads.
    -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.example.meridian</string>
    </array>
</dict>
</plist>
