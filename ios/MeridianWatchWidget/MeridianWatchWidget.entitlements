<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Meridian watch widget extension entitlements.

      The App Group is how the widget reads the last WatchSyncPayload the watch app
      persisted (WatchWidgetStore) — the watch-side analogue of the phone widget's
      shared snapshot.
    -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.example.meridian</string>
    </array>
</dict>
</plist>
