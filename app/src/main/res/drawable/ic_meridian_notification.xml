<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar / quick-settings silhouette of the Meridian globe. Single white colour on a
     transparent canvas so the system can tint it for status bars and themed tiles. Simplified
     (no latitude curve) to stay legible at 24dp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?android:attr/colorControlNormal">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M12,3 a9,9 0 1,1 0,18 a9,9 0 1,1 0,-18 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M3,12 L21,12" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4"
        android:pathData="M12,3 a3.6,9 0 1,0 0,18 a3.6,9 0 1,0 0,-18" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,1.3 a1.8,1.8 0 1,1 0,3.6 a1.8,1.8 0 1,1 0,-3.6 Z" />
</vector>
